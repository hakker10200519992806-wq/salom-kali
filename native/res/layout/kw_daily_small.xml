<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kw_d_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kw_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● BUGUNGI BUYRUQ"
        android:textColor="#3ec28f"
        android:textSize="9sp"
        android:textStyle="bold"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/kw_d_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="#5b9bff"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/kw_d_desc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:textColor="#dbe4f4"
        android:textSize="12sp"
        android:maxLines="5"
        android:ellipsize="end"/>
</LinearLayout>
