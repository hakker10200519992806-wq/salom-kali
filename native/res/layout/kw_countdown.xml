<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kw_c_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kw_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/kw_c_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#f2b84b"
        android:textSize="10sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"/>

    <TextView
        android:id="@+id/kw_c_big"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textColor="#5b9bff"
        android:textSize="42sp"
        android:textStyle="bold"
        android:maxLines="1"/>

    <TextView
        android:id="@+id/kw_c_small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#dbe4f4"
        android:textSize="12sp"
        android:gravity="center"
        android:maxLines="2"/>

    <TextView
        android:id="@+id/kw_c_foot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#8d9db9"
        android:textSize="10sp"
        android:gravity="center"
        android:maxLines="2"
        android:ellipsize="end"/>
</LinearLayout>
