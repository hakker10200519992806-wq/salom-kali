<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kw_bg"
    android:orientation="horizontal"
    android:padding="6dp">

    <LinearLayout
        android:id="@+id/kw_q_term"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/kw_cell"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💻" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Terminal" android:textColor="#dbe4f4" android:textSize="10sp"
            android:textStyle="bold" android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kw_q_test"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/kw_cell"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="✅" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Test" android:textColor="#dbe4f4" android:textSize="10sp"
            android:textStyle="bold" android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kw_q_chal"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/kw_cell"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🎯" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Mashq" android:textColor="#dbe4f4" android:textSize="10sp"
            android:textStyle="bold" android:maxLines="1"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/kw_q_rev"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="3dp"
        android:background="@drawable/kw_cell"
        android:gravity="center"
        android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔁" android:textSize="18sp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Takrorlash" android:textColor="#dbe4f4" android:textSize="10sp"
            android:textStyle="bold" android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
